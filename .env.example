# Server
SERVER_PORT=9090
SERVER_ADDRESS=127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MySQL
MYSQL_ROOT_PASSWORD=root123
DB_USERNAME=videorag
DB_PASSWORD=videorag123
DB_URL=jdbc:mysql://localhost:3307/videorag?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf-8&allowPublicKeyRetrieval=true

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=videorag123

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=videorag
MINIO_SECRET_KEY=videorag123
MINIO_BUCKET=videorag

# Qdrant
QDRANT_ENABLED=true
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=video_chunks

# Elasticsearch
ES_ENABLED=true
ES_URL=http://localhost:9200
ES_INDEX=video_knowledge

# RocketMQ
ROCKETMQ_NAME_SERVER=127.0.0.1:9876
ROCKETMQ_PIPELINE_TOPIC=videorag-pipeline
ROCKETMQ_CONSUMER_GROUP=videorag-pipeline-consumer

# SiliconFlow / model gateway
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
CHAT_MODEL=deepseek-ai/DeepSeek-V3.2
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
ASR_MODEL=FunAudioLLM/SenseVoiceSmall
ASR_SEGMENT_SECONDS=60

# Local tools
FFMPEG_DIR=
FFPROBE_PATH=ffprobe
OCR_COMMAND=tesseract
TESSDATA_PREFIX=

# Rate limits
AI_USER_RPM=20
AI_GLOBAL_RPM=60

# Optional admin bootstrap (leave blank to skip)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345

# Frontend
VITE_DEV_PROXY_TARGET=http://localhost:9090
